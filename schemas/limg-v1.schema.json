{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-image.local/schemas/limg-v1.schema.json",
  "title": "Living Image v1",
  "$comment": "Cross-field ordering, containment, threshold ordering, decoded dimensions, and total image pixels are additionally enforced by src/schema.ts and src/runtime.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "compiler", "image", "analysis", "rig", "behavior", "quality", "provenance"],
  "properties": {
    "format": { "const": "living-image" },
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "compiler": {
      "type": "object",
      "required": ["name", "version", "detector", "detectorVersion", "faceModel", "landmarkModel", "modelSha256"]
    },
    "image": {
      "type": "object",
      "required": ["mimeType", "width", "height", "sha256", "dataUrl"],
      "properties": {
        "mimeType": { "type": "string", "pattern": "^image/" },
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "dataUrl": { "type": "string", "pattern": "^data:image/" }
      }
    },
    "analysis": {
      "type": "object",
      "required": ["face", "landmarks", "features"],
      "properties": {
        "face": { "type": "object", "required": ["bbox", "score"] },
        "landmarks": { "type": "array", "minItems": 28, "maxItems": 28, "items": { "$ref": "#/$defs/scoredPoint" } },
        "features": {
          "type": "object",
          "required": ["eyes", "mouth"],
          "properties": {
            "eyes": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/eyeFeature" },
              "allOf": [
                { "contains": { "type": "object", "required": ["side"], "properties": { "side": { "const": "left" } } }, "minContains": 1, "maxContains": 1 },
                { "contains": { "type": "object", "required": ["side"], "properties": { "side": { "const": "right" } } }, "minContains": 1, "maxContains": 1 }
              ]
            },
            "mouth": { "$ref": "#/$defs/mouthFeature" }
          }
        }
      }
    },
    "rig": { "type": "object", "required": ["controls", "breath"] },
    "behavior": { "type": "object", "required": ["seed", "blink", "breath", "smoothing"] },
    "quality": {
      "type": "object",
      "required": ["status", "score", "disabledCapabilities", "warnings", "rejectionReasons", "metrics"],
      "properties": {
        "status": { "enum": ["full", "limited", "reject"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "provenance": { "type": "object" }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "protectedLineArtMask": {
      "type": "object",
      "required": ["dataUrl", "width", "height", "coverage", "method", "cannyLow", "cannyHigh"],
      "properties": {
        "dataUrl": { "type": "string", "pattern": "^data:image/png;base64," },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "method": { "const": "canny-active-aperture-v1" },
        "cannyLow": { "type": "number", "minimum": 0 },
        "cannyHigh": { "type": "number", "minimum": 0 }
      }
    },
    "embeddedRgbaLayer": {
      "type": "object",
      "required": ["dataUrl", "width", "height", "coverage", "method"],
      "properties": {
        "dataUrl": { "type": "string", "pattern": "^data:image/png;base64,(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=|[A-Za-z0-9+/]{4})$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "method": { "enum": ["source-rgba-ellipse-v1", "telea-inpaint-v1", "telea-skin-fill-curve-v1", "affine-skin-fill-curve-v2", "affine-skin-fill-curve-v3"] }
      }
    },
    "closedEyeCorrective": {
      "allOf": [
        { "$ref": "#/$defs/embeddedRgbaLayer" },
        {
          "type": "object",
          "required": ["activationStart", "lineThickness"],
          "properties": {
            "activationStart": { "type": "number", "minimum": 0.5, "exclusiveMaximum": 1 },
            "lineThickness": { "type": "integer", "minimum": 1, "maximum": 8 },
            "inpaintRadius": { "type": "integer", "minimum": 1, "maximum": 16 },
            "sampleExclusionRadius": { "type": "integer", "minimum": 1, "maximum": 32 },
            "retainedSamplePixels": { "type": "integer", "minimum": 48 },
            "medianFitResidual": { "type": "number", "minimum": 0 },
            "upperSamplesIncluded": { "type": "boolean" }
          },
          "oneOf": [
            {
              "required": ["inpaintRadius"],
              "properties": { "method": { "const": "telea-skin-fill-curve-v1" } }
            },
            {
              "required": ["sampleExclusionRadius", "retainedSamplePixels", "medianFitResidual"],
              "properties": { "method": { "const": "affine-skin-fill-curve-v2" } }
            },
            {
              "required": ["sampleExclusionRadius", "retainedSamplePixels", "medianFitResidual", "upperSamplesIncluded"],
              "properties": { "method": { "const": "affine-skin-fill-curve-v3" } }
            }
          ]
        }
      ]
    },
    "irisDeformation": {
      "type": "object",
      "required": ["method", "texture", "baseEye", "centre", "radiusX", "radiusY", "inpaintRadius", "segmentationConfidence"],
      "properties": {
        "method": { "const": "ellipse-cage-telea-v1" },
        "texture": {
          "allOf": [
            { "$ref": "#/$defs/embeddedRgbaLayer" },
            { "type": "object", "properties": { "method": { "const": "source-rgba-ellipse-v1" } } }
          ]
        },
        "baseEye": {
          "allOf": [
            { "$ref": "#/$defs/embeddedRgbaLayer" },
            { "type": "object", "properties": { "method": { "const": "telea-inpaint-v1" } } }
          ]
        },
        "centre": { "$ref": "#/$defs/point" },
        "radiusX": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "radiusY": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "inpaintRadius": { "type": "integer", "minimum": 1 },
        "segmentationConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "semanticControlField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "weights", "maxDisplacements"],
      "properties": {
        "control": { "const": "blink" },
        "weights": {
          "type": "array",
          "minItems": 3,
          "maxItems": 128,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "maxDisplacements": {
          "type": "array",
          "minItems": 3,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/point" }
        }
      }
    },
    "eyeSemanticMesh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "vertices", "triangles", "fields", "aperture", "minimumAreaRatio"],
      "properties": {
        "method": { "const": "semantic-weighted-triangle-mesh-v1" },
        "vertices": {
          "type": "array",
          "minItems": 3,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/point" }
        },
        "triangles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "integer", "minimum": 0, "maximum": 127 }
          }
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/semanticControlField" }
        },
        "aperture": {
          "type": "array",
          "minItems": 6,
          "maxItems": 128,
          "items": { "type": "integer", "minimum": 0, "maximum": 127 }
        },
        "minimumAreaRatio": { "type": "number", "minimum": 0.02, "maximum": 1 }
      }
    },
    "eyeFeature": {
      "type": "object",
      "required": ["side", "region", "anchors", "pupil", "rig"],
      "properties": {
        "side": { "enum": ["left", "right"] },
        "region": { "$ref": "#/$defs/rect" },
        "anchors": {
          "type": "object",
          "required": ["left", "right", "top", "bottom", "centreY"],
          "properties": {
            "left": { "type": "number" },
            "right": { "type": "number" },
            "top": { "type": "number" },
            "bottom": { "type": "number" },
            "centreY": { "type": "number" }
          }
        },
        "pupil": {
          "allOf": [
            { "$ref": "#/$defs/point" },
            {
              "type": "object",
              "required": ["radius", "confidence", "contrast", "method"],
              "properties": {
                "radius": { "type": "number", "exclusiveMinimum": 0 },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "contrast": { "type": "number", "minimum": 0 },
                "method": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "rig": {
          "type": "object",
          "required": ["maxGazeX", "maxGazeY", "blinkFloor"],
          "properties": {
            "maxGazeX": { "type": "number", "minimum": 0, "maximum": 1 },
            "maxGazeY": { "type": "number", "minimum": 0, "maximum": 1 },
            "blinkFloor": { "type": "number", "minimum": 0, "maximum": 1 },
            "deformation": {
              "type": "object",
              "required": ["method", "sourceRows", "closedRows", "gazeRowWeights", "protectedLineArtMask", "region"],
              "properties": {
                "method": { "const": "fixed-boundary-piecewise-affine-v1" },
                "sourceRows": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "number" } },
                "closedRows": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "number" } },
                "gazeRowWeights": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
                "protectedLineArtMask": { "$ref": "#/$defs/protectedLineArtMask" },
                "iris": { "$ref": "#/$defs/irisDeformation" },
                "semanticMesh": { "$ref": "#/$defs/eyeSemanticMesh" },
                "closedEye": { "$ref": "#/$defs/closedEyeCorrective" },
                "region": { "$ref": "#/$defs/rect" }
              }
            }
          }
        }
      }
    },
    "mouthFeature": {
      "type": "object",
      "required": ["region", "anchors", "rig"],
      "properties": {
        "region": { "$ref": "#/$defs/rect" },
        "anchors": {
          "type": "object",
          "required": ["left", "right", "centreX", "centreY"],
          "properties": {
            "left": { "type": "number" },
            "right": { "type": "number" },
            "centreX": { "type": "number" },
            "centreY": { "type": "number" }
          }
        },
        "lineConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rig": {
          "type": "object",
          "required": ["maxOpen", "interiorColour"],
          "properties": {
            "maxOpen": { "type": "number", "minimum": 0, "maximum": 1 },
            "interiorColour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "deformation": {
              "type": "object",
              "required": ["method", "upperBand", "lowerBand", "cavity", "upperTravel", "lowerTravel", "lineContrast"],
              "properties": {
                "method": { "const": "bounded-lip-bands-v1" },
                "upperBand": { "$ref": "#/$defs/rect" },
                "lowerBand": { "$ref": "#/$defs/rect" },
                "cavity": {
                  "type": "object",
                  "required": ["centreX", "centreY", "radiusX", "maxRadiusY"],
                  "properties": {
                    "centreX": { "type": "number" },
                    "centreY": { "type": "number" },
                    "radiusX": { "type": "number", "exclusiveMinimum": 0 },
                    "maxRadiusY": { "type": "number", "exclusiveMinimum": 0 }
                  }
                },
                "upperTravel": { "type": "number", "minimum": 0 },
                "lowerTravel": { "type": "number", "minimum": 0 },
                "lineContrast": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "scoredPoint": {
      "allOf": [
        { "$ref": "#/$defs/point" },
        { "type": "object", "required": ["score"], "properties": { "score": { "type": "number" } } }
      ]
    }
  }
}
