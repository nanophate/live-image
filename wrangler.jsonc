{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "living-image",
  "main": "./deploy/cloudflare/worker.ts",
  "compatibility_date": "2026-07-21",
  "preview_urls": false,
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "secrets": {
    "required": [
      "ACCESS_POLICY_AUD",
      "ACCESS_TEAM_DOMAIN",
      "REVIEW_PASSWORD",
      "REVIEW_SESSION_SECRET"
    ]
  },
  "ratelimits": [
    {
      "name": "REVIEW_LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "COMPILER_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "containers": [
    {
      "class_name": "CompilerContainer",
      "image": "./Dockerfile",
      "image_vars": {
        "LIVING_IMAGE_TARGET": "living-image-cloudflare"
      },
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COMPILER",
        "class_name": "CompilerContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CompilerContainer"]
    }
  ],
  "vars": {
    "AUTH_MODE": "access",
    "HOSTED_COMPILER_ENABLED": "true",
    "PUBLIC_REVIEW_EXPIRES_AT": "",
    "PUBLIC_REVIEW_NOT_BEFORE": "",
    "REQUIRE_ACCESS_JWT": "true",
    "REVIEW_AUTH_VERSION": "1"
  }
}
